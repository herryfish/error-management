# 错题管理系统环境变量配置示例

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=error_management

# ==================== LLM配置 ====================

# 主LLM配置
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4-vision-preview
LLM_PRIMARY_API_KEY=sk-your-openai-api-key
LLM_PRIMARY_API_BASE=https://api.openai.com/v1

# 降级LLM配置（可选）
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-3-opus-20240229
LLM_FALLBACK_API_KEY=sk-ant-your-anthropic-api-key
LLM_FALLBACK_API_BASE=https://api.anthropic.com

# 降级策略配置
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_RETRY_COUNT=2
LLM_FALLBACK_TIMEOUT_MS=30000

# ==================== 服务器配置 ====================
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# ==================== 安全配置 ====================
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# ==================== 文件存储配置 ====================
STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ==================== 其他配置 ====================
NODE_ENV=production
DEBUG=false