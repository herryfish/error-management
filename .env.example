# 错题管理系统环境变量配置示例

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=error_management

# ==================== LLM配置 ====================

# 主LLM配置
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_PRIMARY_API_KEY=sk-your-openai-api-key
LLM_PRIMARY_API_BASE=https://api.openai.com/v1
# 主模型调用超时（毫秒，默认 120000；整页多题 Vision 识别常超 15-30s，勿设过小）
LLM_PRIMARY_TIMEOUT_MS=120000

# 降级LLM配置（可选）
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-3-opus-20240229
LLM_FALLBACK_API_KEY=sk-ant-your-anthropic-api-key
LLM_FALLBACK_API_BASE=https://api.anthropic.com

# 降级策略配置
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_RETRY_COUNT=2
LLM_FALLBACK_TIMEOUT_MS=30000

# ==================== 复习调度器（v1.4） ====================
# 复习排程模式：ebbinghaus（静态 1/2/4/7/15 天，默认）| fsrs（FSRS 动态自适应调度）
# 切换 fsrs 前建议先用 npm run replay:compare 做既有复习记录回放对比，再小规模灰度
REVIEW_SCHEDULER=ebbinghaus
# FSRS 毕业阈值（天）：做对且下次间隔 ≥ 该值即判定已掌握（清本毕业）
FSRS_GRADUATION_DAYS=30
# FSRS 目标留存率（0.5~1，默认 0.9）：越高复习越频、遗忘越少
FSRS_REQUEST_RETENTION=0.9
# 顽固薄弱点阈值：累计做错 ≥ 该次数自动打「顽固薄弱点」标记
STUBBORN_INCORRECT_THRESHOLD=3

# ==================== uploads 临时文件清理（S6） ====================
# uploads 目录过期文件 TTL（小时）：仅删除超过 TTL 且未被错题引用的临时图；0 = 关闭清理
UPLOADS_TTL_HOURS=72

# ==================== 异步任务队列（整页多题识别） ====================
# Redis + BullMQ 队列（docker-compose 默认 redis://redis:6379）。
# 留空时自动降级为进程内队列：接口行为一致（立即返回 taskId + 轮询），
# 但任务不跨进程重启保留，仅建议单实例自托管场景。
REDIS_URL=redis://redis:6379

# ==================== 服务器配置 ====================
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# ==================== 安全配置 ====================
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# ==================== 文件存储配置 ====================
STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760  # 10MB

# ==================== 日志配置 ====================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ==================== 其他配置 ====================
NODE_ENV=production
DEBUG=false